{
    "manifest_version": 3,
    "name": "ScrapBro",
    "version": "0.0.0",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "minimum_chrome_version": "116",
    "permissions": [
        "activeTab",
        "contextMenus",
        "downloads",
        "storage",
        "tabs",
        "unlimitedStorage",
        "webNavigation",
        "nativeMessaging",
        "notifications",
        "scripting",
        "sidePanel"
    ],
    "host_permissions": [
        "<all_urls>",
        "file:///*"
    ],
    "side_panel": {
        "default_path": "html/sidebar.html"
    },
    "background": {
        "service_worker": "js/background.js",
        "type": "module"
    },
    "action": {
        "default_title": "ScrapBro",
        "default_popup": "popup/browser_action.html"
    },
    "options_ui": {
        "open_in_tab": true,
        "page": "html/options.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "css/*",
                "icons/*",
                "html/advcap.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "commands": {
        "open-sidebar": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "MacCtrl+Shift+Y"
            },
            "description": "Open ScrapBro side panel"
        }
    }
}
